<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="delonix">
      <param name="gateway-url" value="http://127.0.0.1:8430/internal/v1/telephony/freeswitch-config" bindings="dialplan|directory"/>
      <param name="gateway-credentials" value="freeswitch:SUBSTITUIR_VOICE_INTERNAL_SECRET"/>
      <param name="auth-scheme" value="basic"/>
      <param name="timeout" value="5"/>
    </binding>
  </bindings>
</configuration>
