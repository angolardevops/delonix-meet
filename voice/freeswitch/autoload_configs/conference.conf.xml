<!--
  Delonix Meet — perfil de conferência 'delonix'.
  A conferência mistura áudio já decifrado: NÃO é aqui que se impõe SRTP. Isso
  é de cada perna SIP, pela variável global rtp_secure_media=mandatory
  (sip_profiles/internal.xml e o arranque; R226). O mod_conference 1.11.3
  não tem nenhum parâmetro de segurança de media.
  Drop-in em /etc/freeswitch/autoload_configs/conference.conf.xml (ou incluir).
  Cada sala de conferência é criada dinamicamente com o nome = room_code.
-->
<configuration name="conference.conf" description="Delonix conference">
  <profiles>
    <profile name="delonix">
      <param name="rate" value="8000"/>
      <param name="interval" value="20"/>
      <param name="energy-level" value="100"/>
      <param name="comfort-noise" value="true"/>
      <!-- Codecs de telefonia; Opus opcional se o trunk suportar. -->
      <param name="conference-flags" value="video-mute-exit"/>
      <!-- Sem controlos por DTMF dentro da conferência. O valor tem de ser
           "none" ou o nome de um grupo definido NESTE ficheiro, numa secção
           caller-controls: pedia-se "default", que só existe no ficheiro da
           vanilla que este substitui, e cada entrada na conferência registava
           «Can't find caller-controls in conference.conf» e ficava sem controlos
           na mesma (R228). "none" é o que já acontecia, sem o erro. -->
      <param name="caller-controls" value="none"/>
      <!-- Sem PIN aqui: o PIN é validado no IVR contra o control plane. -->
      <param name="max-members" value="0"/>
    </profile>
  </profiles>
</configuration>
