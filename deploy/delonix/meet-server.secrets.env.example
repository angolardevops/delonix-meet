# Configuração SENSÍVEL e ESPECÍFICA DO HOST do delonix-server.
# Copiar para meet-server.secrets.env (ignorado pelo git) e substituir TODOS os
# CHANGE_ME. O servidor é fail-closed: com segredos fracos não arranca.
# Referência de cada variável: docs/deployment.md §3.

# --- segredos ---------------------------------------------------------------
# A password tem de ser a MESMA do POSTGRES_PASSWORD em meet-db.secrets.env.
DATABASE_URL=postgres://delonix:CHANGE_ME@meet-postgres:5432/delonix_meet
# openssl rand -hex 48   (trocá-lo desliga todas as sessões)
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32   — IGUAL ao static-auth-secret em meet-coturn.secrets.env
TURN_SECRET=CHANGE_ME
# Vazio = desligado (fail-closed).
PROVISIONING_SECRET=
VOICE_INTERNAL_SECRET=
PLATFORM_ADMIN_USER_IDS=

# --- específico do host ------------------------------------------------------
# IP/nome ALCANÇÁVEL PELO BROWSER onde o coturn escuta (R4).
TURN_HOST=CHANGE_ME:3478
# IP que o SFU anuncia nos candidatos ICE (o IP público/LAN deste host).
SFU_EXTERNAL_IP=CHANGE_ME
