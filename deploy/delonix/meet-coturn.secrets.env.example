# Ficheiro de configuração do coturn, entregue em /run/secrets/TURN_CONFIG.
# Copiar para meet-coturn.secrets.env (ignorado pelo git). O valor depois do
# primeiro `=` é UMA linha de turnserver.conf: o segredo tem de ser o MESMO
# TURN_SECRET de meet-server.secrets.env.
TURN_CONFIG=static-auth-secret=CHANGE_ME
