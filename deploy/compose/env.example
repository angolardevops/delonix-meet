# Segredos do `compose.yaml` (simulação de produção) e do `make cluster`.
# `make bootstrap` copia este ficheiro para `.env` e gera os valores — não o
# preenchas à mão e NUNCA versiones o `.env`.
#
# O compose.yaml lê-o por `env_file` (sem interpolação); o scripts/cluster.sh
# lê daqui os segredos e monta o seu próprio DATABASE_URL.

# --- gerados por `make bootstrap` (openssl rand) ---
POSTGRES_PASSWORD=
JWT_SECRET=
TURN_SECRET=
PROVISIONING_SECRET=
VOICE_INTERNAL_SECRET=
# A conta de validação que o `make seed` cria (admin@ngolacloud.local, org «ngolacloud»).
MEET_ADMIN_PASSWORD=
# Interfaces de administração do Kamailio e do PBX de cliente (utilizador «admin»).
VOICE_ADMIN_PASSWORD=
# Derivado do POSTGRES_PASSWORD; o host `delonix-postgres` é o contentor do compose.
DATABASE_URL=
