DATABASE_URL={{ database_url }}
BIND_ADDR=127.0.0.1:8180
JWT_SECRET={{ jwt_secret }}
TURN_HOST={{ served_host }}:3478
TURN_SECRET={{ turn_secret }}
CORS_ORIGINS=
RECORDINGS_DIR={{ recordings_dir }}
REDIS_URL=redis://127.0.0.1:6379
VOICE_INTERNAL_SECRET={{ voice_secret }}
{% if public_ip_effective is defined and public_ip_effective | length > 0 %}
SFU_EXTERNAL_IP={{ public_ip_effective }}
{% endif %}
# Produção é HTTPS via nginx → cookie de refresh Secure (COOKIE_INSECURE não definido).
