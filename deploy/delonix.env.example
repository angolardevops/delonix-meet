# ============================================================
#  Delonix Meet — variáveis de ambiente de PRODUÇÃO
#  Copiar para /etc/delonix/delonix.env, preencher os segredos,
#  e referenciar no systemd (EnvironmentFile). Permissões: 600.
#
#    sudo install -d -m 750 /etc/delonix
#    sudo cp deploy/delonix.env.example /etc/delonix/delonix.env
#    sudo chmod 600 /etc/delonix/delonix.env
#
#  IMPORTANTE: em produção NÃO definir DELONIX_ALLOW_INSECURE.
#  Sem segredos fortes o servidor faz panic no arranque (fail-closed).
# ============================================================

# --- Base de dados (usar password FORTE, não o default de dev) ---
DATABASE_URL=postgres://delonix:TROCAR_PASSWORD_FORTE@localhost:5435/delonix_meet

# --- Segredo JWT (>= 32 bytes). Gerar: openssl rand -hex 48 ---
JWT_SECRET=TROCAR_por_openssl_rand_hex_48

# --- coturn: host público e segredo (>= 16 bytes) ---
# O TURN_SECRET TEM de ser igual ao --static-auth-secret do coturn.
# Gerar: openssl rand -hex 32
TURN_HOST=turn.meet.example.com:3478
TURN_SECRET=TROCAR_igual_ao_coturn_static_auth_secret

# --- CORS: origens permitidas (a própria SPA). Vazio = same-origin only. ---
# Como o nginx serve app e API no mesmo host, normalmente deixar VAZIO.
# Só preencher se a SPA for servida noutra origem.
CORS_ORIGINS=

# --- Endereço de bind (o nginx faz proxy para aqui) ---
BIND_ADDR=127.0.0.1:8180

# --- Diretório das gravações (disco com espaço; incluir nos backups) ---
RECORDINGS_DIR=/var/lib/delonix/recordings

# --- Cookie de refresh: Secure ON por omissão (produção é HTTPS via nginx). ---
# Só definir COOKIE_INSECURE=1 se servires em HTTP puro (NÃO recomendado).
# COOKIE_INSECURE=1

# ============================================================
#  Login com conta Odoo (opcional)
# ============================================================
# Com estas duas definidas, quem tiver conta no Odoo entra no Meet com as
# MESMAS credenciais, e no primeiro login:
#   1. a organização é criada a partir da EMPRESA do utilizador no Odoo;
#   2. ele entra como membro (admin, se for administrador no Odoo);
#   3. todos os utilizadores internos activos dessa empresa são
#      sincronizados em segundo plano (o directório aparece completo).
#
# FAIL-CLOSED: vazias (o default) => o login por Odoo está DESLIGADO e só
# entra quem já foi provisionado. Nada muda no comportamento existente.
#
# É deliberadamente configuração de PLATAFORMA e não de organização: no
# primeiro login ainda não existe organização nenhuma onde guardar isto —
# é precisamente a org que está a nascer. Depois de criada, a configuração
# por-org (URL, BD, token) fica preenchida sozinha e é editável em
# Análises -> Integração Odoo.
#
# LIMITE ACTUAL: uma instância Odoo por plataforma. Para várias empresas em
# Odoos diferentes, é preciso resolver o Odoo pelo domínio de email do
# utilizador — ainda não implementado.
#
# PLATFORM_ODOO_URL=https://erp.empresa.com
# PLATFORM_ODOO_DB=empresa_prod
