# syntax=docker/dockerfile:1
# ============================================================
#  Delonix Meet — imagem do frontend (SPA + Nginx)
#  Runtime ROOTLESS: nginx-unprivileged (uid 101, porta 8080, sem root).
#  Inclui os assets de IA self-hosted (ORT wasm + modelo RVM) para uma
#  imagem reprodutível — nada é buscado à internet em runtime.
# ============================================================

FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./

# --- Assets de IA (mesma lógica do deploy.sh ensure_matting_assets) ---
# ONNX runtime do Whisper (transformers.js, onnxruntime 1.14) -> /ort
# ONNX runtime do RVM (onnxruntime-web 1.19, com WebGPU) -> /ort-rvm
ARG RVM_MODEL_URL=https://github.com/PeterL1n/RobustVideoMatting/releases/download/v1.0.0/rvm_mobilenetv3_fp32.onnx
ARG RVM_MODEL_SHA256=88d4531297118f595bf2fd60f6f566aec2e559393802d1f436c380f0cbbd2828
RUN set -eux; \
    mkdir -p public/ort public/ort-rvm public/models/rvm; \
    cp node_modules/@xenova/transformers/node_modules/onnxruntime-web/dist/ort-wasm*.wasm public/ort/; \
    for f in ort-wasm-simd-threaded.wasm ort-wasm-simd-threaded.mjs \
             ort-wasm-simd-threaded.jsep.wasm ort-wasm-simd-threaded.jsep.mjs; do \
      cp "node_modules/onnxruntime-web/dist/$f" "public/ort-rvm/$f"; \
    done
ADD ${RVM_MODEL_URL} public/models/rvm/rvm_mobilenetv3_fp32.onnx
RUN echo "${RVM_MODEL_SHA256}  public/models/rvm/rvm_mobilenetv3_fp32.onnx" | sha256sum -c -

# Modelo Whisper-tiny (transcrição local, self-hosted) — FORA do git, obtido do
# HuggingFace com SHA-256 fixado. Mesma fonte de verdade que o deploy.sh.
COPY deploy/fetch-whisper.sh ./fetch-whisper.sh
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && bash ./fetch-whisper.sh public/models/Xenova/whisper-tiny

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
# nginx-unprivileged já corre como uid 101 (não-root) e escuta em 8080.
COPY deploy/k8s/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 8080
