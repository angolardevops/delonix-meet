{
  "components": {
    "schemas": {
      "AtPdu": {
        "description": "Um PDU pronto para `AT+CMGS=<tpdu_len>` seguido de `<hex>` e Ctrl-Z.",
        "properties": {
          "hex": {
            "type": "string"
          },
          "tpdu_len": {
            "description": "Octetos do TPDU, SEM o octeto do SMSC — é o número que o `AT+CMGS` pede.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hex",
          "tpdu_len"
        ],
        "type": "object"
      },
      "BalanceReport": {
        "properties": {
          "amount": {
            "description": "Decimal (`\"2140.00\"`).",
            "type": "string"
          },
          "currency": {
            "description": "`AOA` | `USD`.",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "ClaimResp": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ClaimedMessage"
            },
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      },
      "ClaimedMessage": {
        "properties": {
          "body": {
            "type": "string"
          },
          "device_key": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "pdus": {
            "items": {
              "$ref": "#/components/schemas/AtPdu"
            },
            "type": "array"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "device_key",
          "to",
          "body",
          "pdus"
        ],
        "type": "object"
      },
      "DeviceReport": {
        "properties": {
          "balance": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BalanceReport",
                "description": "Saldo do SIM, se o agente o consulta (USSD). Ausente mantém o último."
              }
            ]
          },
          "battery_percent": {
            "description": "Bateria de um telefone-gateway (0-100), se o agente a lê.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "capable": {
            "type": "boolean"
          },
          "device_key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "string",
              "null"
            ]
          },
          "product": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "serial": {
            "type": [
              "string",
              "null"
            ]
          },
          "signal_percent": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "transport": {
            "type": "string"
          },
          "vendor_id": {
            "type": "string"
          }
        },
        "required": [
          "device_key",
          "vendor_id",
          "product_id",
          "kind",
          "transport",
          "capable"
        ],
        "type": "object"
      },
      "DevicesReq": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceReport"
            },
            "type": "array"
          }
        },
        "required": [
          "devices"
        ],
        "type": "object"
      },
      "DevicesResp": {
        "properties": {
          "poll_interval_secs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "poll_interval_secs"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "Envelope de erro de todas as superfícies (ver `error.rs`).",
        "properties": {
          "code": {
            "description": "Código estável (contrato), p.ex. `registration.domain_taken`.",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "type": "array"
          },
          "error": {
            "description": "Mensagem para pessoas. Pode mudar.",
            "type": "string"
          },
          "request_id": {
            "description": "Igual ao cabeçalho `X-Request-Id`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "code",
          "details"
        ],
        "type": "object"
      },
      "FieldViolation": {
        "properties": {
          "description": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "description"
        ],
        "type": "object"
      },
      "OdooDirectoryUser": {
        "description": "Membro da organização, como o Odoo o vê.",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "odoo_uid": {
            "description": "`null` se a conta não veio do Odoo.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "role": {
            "description": "Papel na organização (`admin` | `member`).",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "role"
        ],
        "type": "object"
      },
      "OdooUserEntry": {
        "properties": {
          "department_id": {
            "description": "Departamento no Odoo (`hr.department`): o id e o nome.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "department_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "groups": {
            "description": "Ids externos dos grupos (`modulo.nome`) — mapeiam papéis (ADR-0008 §9).\nAusente = não enviados: o papel não muda.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "is_admin": {
            "type": "boolean"
          },
          "mobile_phone": {
            "description": "`hr.employee.mobile_phone` / `work_phone`. Aditivos à v1: ausentes não\nmexem no número; `false`/`\"\"` apagam o que veio do Odoo; um número\neditado à mão no Delonix nunca é sobrescrito (migração 0060)."
          },
          "name": {
            "type": "string"
          },
          "odoo_uid": {
            "format": "int32",
            "type": "integer"
          },
          "work_phone": {}
        },
        "required": [
          "odoo_uid",
          "name",
          "email"
        ],
        "type": "object"
      },
      "ProvisionReq": {
        "properties": {
          "admin_email": {
            "description": "Email do utilizador que fez a integração — será admin da org.",
            "type": "string"
          },
          "company": {
            "description": "Nome da empresa Odoo (actualiza o nome da org se a org ainda tem o nome\npadrão ou se force_name=true).",
            "type": "string"
          },
          "full_directory": {
            "description": "`true` = a lista é o directório COMPLETO: com «suspender ao sair do Odoo»\nactivo, quem não vem nela é suspenso (`odoo_exit`).",
            "type": "boolean"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/OdooUserEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "company",
          "admin_email"
        ],
        "type": "object"
      },
      "ProvisionResult": {
        "properties": {
          "created": {
            "minimum": 0,
            "type": "integer"
          },
          "org_id": {
            "format": "uuid",
            "type": "string"
          },
          "phones_rejected": {
            "description": "Membros sincronizados cujo telefone do Odoo NÃO foi gravado (ex.: número\nfora de Angola, que o encaminhamento de SMS não serve). Aditivo à v1.",
            "items": {
              "$ref": "#/components/schemas/SkippedUser"
            },
            "type": "array"
          },
          "role_changes": {
            "description": "Papéis mudados por grupo do Odoo.",
            "minimum": 0,
            "type": "integer"
          },
          "role_conflicts": {
            "description": "Conflitos de papel criados (a decidir na consola).",
            "minimum": 0,
            "type": "integer"
          },
          "skipped": {
            "description": "Entradas do directório que NÃO foram aplicadas, com a razão. Aditivo à\nv1: um integrador antigo ignora o campo, e continua a receber `created`\ne `updated` com o mesmo significado.",
            "items": {
              "$ref": "#/components/schemas/SkippedUser"
            },
            "type": "array"
          },
          "suspended": {
            "description": "Suspensos por saída do Odoo (`full_directory`).",
            "minimum": 0,
            "type": "integer"
          },
          "updated": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "org_id",
          "created",
          "updated",
          "skipped",
          "phones_rejected",
          "role_changes",
          "role_conflicts",
          "suspended"
        ],
        "type": "object"
      },
      "ResultReq": {
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "provider_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "SkippedUser": {
        "properties": {
          "email": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "reason"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api_key": {
        "description": "Chave de API da organização (`dlx_…`).",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "bearerFormat": "JWT",
        "description": "Access token da sessão (15 min), renovado por /api/auth/refresh.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Módulo Odoo `nk_delonix_meet` (token `dlxo_`) e agente de SMS por USB (token `dlxg_`).",
    "license": {
      "name": ""
    },
    "title": "Delonix Meet — Integrações",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/integrations/odoo/v1/provision": {
      "post": {
        "description": "Provisiona o directório de utilizadores do Odoo na organização do token.\n\nAutentica SÓ pelo token de integração `dlxo_` (a chave `dlx_` da organização recebe `401`), em `Authorization: Bearer …` ou `X-Integration-Token: …`. Uma entrada cuja conta pertence a outra organização ou é local não é aplicada e vem em `skipped`.",
        "operationId": "provision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionResult"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Token em falta, desconhecido, integração desactivada, ou chave `dlx_` (não é o token desta rota)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Rate-limit da v1 por IP."
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "`POST /api/integrations/odoo/v1/provision`\nChamado pelo módulo nk_delonix_meet para provisionar utilizadores.",
        "tags": [
          "odoo"
        ]
      }
    },
    "/api/integrations/odoo/v1/users": {
      "get": {
        "description": "Membros ACTIVOS da organização do token (os arquivados não saem), por `username`.\n\nAutentica SÓ pelo token de integração `dlxo_` (a chave `dlx_` da organização recebe `401`), em `Authorization: Bearer …` ou `X-Integration-Token: …`.",
        "operationId": "list_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OdooDirectoryUser"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Token em falta, desconhecido, integração desactivada, ou chave `dlx_` (não é o token desta rota)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Rate-limit da v1 por IP."
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "`GET /api/integrations/odoo/v1/users` — lista utilizadores para o Odoo",
        "tags": [
          "odoo"
        ]
      }
    },
    "/api/integrations/sms-agent/v1/claim": {
      "post": {
        "operationId": "agent_claim",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResp"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Token `dlxg_` inválido ou revogado."
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "sms"
        ]
      }
    },
    "/api/integrations/sms-agent/v1/devices": {
      "put": {
        "operationId": "agent_put_devices",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicesReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesResp"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Token `dlxg_` inválido ou revogado."
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "Substitui o inventário deste gateway. Um dispositivo que deixa de aparecer\nNÃO é apagado — fica desligado (`online: false`) e mantém a selecção, para\nque tirar e voltar a ligar o cabo não obrigue a escolher outra vez.",
        "tags": [
          "sms"
        ]
      }
    },
    "/api/integrations/sms-agent/v1/messages/{message_id}/result": {
      "post": {
        "operationId": "agent_result",
        "parameters": [
          {
            "in": "path",
            "name": "message_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Registado."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Token `dlxg_` inválido ou revogado."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "tags": [
          "sms"
        ]
      }
    }
  }
}
