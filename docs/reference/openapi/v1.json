{
  "components": {
    "schemas": {
      "ApiCreateRoomReq": {
        "properties": {
          "e2ee": {
            "type": "boolean"
          },
          "name": {
            "description": "Omisso ⇒ «Reunião (API)»; cortado a 120 caracteres.",
            "type": [
              "string",
              "null"
            ]
          },
          "waiting_room": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "CreateMeetingReq": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionOptions"
          },
          {
            "properties": {
              "description": {
                "type": "string"
              },
              "duration_min": {
                "default": 30,
                "description": "5-1440 minutos.",
                "format": "int32",
                "type": "integer"
              },
              "invitee_ids": {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "default": "video",
                "description": "`video` (omissão) | `voice`.",
                "type": "string"
              },
              "recurrence_byday": {
                "description": "Dias da semana para freq=weekly: \"MON,WED,FRI\"",
                "type": [
                  "string",
                  "null"
                ]
              },
              "recurrence_count": {
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "recurrence_freq": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recurrence_interval": {
                "default": 1,
                "format": "int32",
                "type": "integer"
              },
              "recurrence_until": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "room_ref": {
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "sms_invite": {
                "description": "Avisar os convidados por SMS ao agendar (sms_notify).",
                "type": "boolean"
              },
              "sms_reminder_min": {
                "description": "Lembrete por SMS N minutos antes (5–1440). Nulo = sem lembrete.",
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "starts_at": {
                "format": "date-time",
                "type": "string"
              },
              "title": {
                "description": "1-140 caracteres (depois de `trim`).",
                "type": "string"
              }
            },
            "required": [
              "title",
              "starts_at"
            ],
            "type": "object"
          }
        ]
      },
      "DeleteMeetingResp": {
        "description": "Resposta de `DELETE /api/v1/meetings/{id}`.",
        "properties": {
          "ok": {
            "description": "Sempre `true`.",
            "type": "boolean"
          },
          "room_deleted": {
            "description": "`false` quando a sala foi mantida por ter gravações (ou a reunião não\ntinha sala).",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "room_deleted"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "Envelope de erro de todas as superfícies (ver `error.rs`).",
        "properties": {
          "code": {
            "description": "Código estável (contrato), p.ex. `registration.domain_taken`.",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "type": "array"
          },
          "error": {
            "description": "Mensagem para pessoas. Pode mudar.",
            "type": "string"
          },
          "request_id": {
            "description": "Igual ao cabeçalho `X-Request-Id`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "code",
          "details"
        ],
        "type": "object"
      },
      "FieldViolation": {
        "properties": {
          "description": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "description"
        ],
        "type": "object"
      },
      "InviteeReq": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "InviteeResp": {
        "properties": {
          "email": {
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "email",
          "user_id"
        ],
        "type": "object"
      },
      "JoinBotReq": {
        "properties": {
          "bot_name": {
            "description": "Nome mostrado na sala; vazio ⇒ «AI Assistant»; cortado a 40 caracteres.",
            "type": "string"
          }
        },
        "required": [
          "bot_name"
        ],
        "type": "object"
      },
      "MeetingResp": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionOptions"
          },
          {
            "properties": {
              "duration_min": {
                "format": "int32",
                "type": "integer"
              },
              "existing": {
                "description": "`true` quando o pedido reencontrou uma reunião já existente pela\n`external_ref` em vez de criar uma nova.",
                "type": "boolean"
              },
              "external_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host_email": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "invitees": {
                "description": "Convidados efectivamente registados (email -> id do utilizador).",
                "items": {
                  "$ref": "#/components/schemas/InviteeResp"
                },
                "type": "array"
              },
              "join_url": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "room_code": {
                "type": "string"
              },
              "skipped": {
                "description": "Emails NÃO registados e porquê. Nunca falha o pedido por causa de um\nconvidado — o link tem de sair na mesma.",
                "items": {
                  "$ref": "#/components/schemas/SkippedInvitee"
                },
                "type": "array"
              },
              "starts_at": {
                "format": "date-time",
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "starts_at",
              "duration_min",
              "kind",
              "room_code",
              "join_url",
              "host_email",
              "invitees",
              "skipped",
              "existing"
            ],
            "type": "object"
          }
        ]
      },
      "PatchMeetingReq": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionOptionsPatch",
            "description": "Opções de sessão; a ausente fica como está. Passam também à sala."
          },
          {
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration_min": {
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "invitees": {
                "description": "Se presente, **substitui** o conjunto de convidados. O estado de\nresposta (aceite/recusado) de quem se mantém é preservado.",
                "items": {
                  "$ref": "#/components/schemas/InviteeReq"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "starts_at": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "SessionOptions": {
        "description": "Opções de sessão de uma reunião (migração 0059).",
        "properties": {
          "auto_record": {
            "type": "boolean"
          },
          "format": {
            "type": "string"
          },
          "record_quality": {
            "type": "string"
          },
          "waiting_room": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "SessionOptionsPatch": {
        "description": "Alteração parcial das opções de sessão: o campo ausente fica como está.",
        "properties": {
          "auto_record": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_quality": {
            "type": [
              "string",
              "null"
            ]
          },
          "waiting_room": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "SkippedInvitee": {
        "properties": {
          "email": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "reason"
        ],
        "type": "object"
      },
      "V1BotJoin": {
        "description": "Credenciais de entrada de um bot numa sala.",
        "properties": {
          "room": {
            "description": "A sala completa (`id`, `code`, `name`, `owner_id`, `topology`,\n`waiting_room`, `e2ee`, `format`, `created_at`).",
            "type": "object"
          },
          "room_token": {
            "description": "JWT `typ: \"room\"` com `is_bot: true`, atribuído ao criador da chave.",
            "type": "string"
          },
          "ws_path": {
            "description": "`/ws?token=<room_token>`.",
            "type": "string"
          }
        },
        "required": [
          "room",
          "room_token",
          "ws_path"
        ],
        "type": "object"
      },
      "V1MeetingList": {
        "properties": {
          "meetings": {
            "items": {
              "$ref": "#/components/schemas/V1MeetingSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "meetings"
        ],
        "type": "object"
      },
      "V1MeetingNotes": {
        "description": "Ata e transcrição de uma reunião.",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "minutes": {
            "description": "Ata (MoM).",
            "type": "string"
          },
          "minutes_ai_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "transcript": {
            "description": "Transcrição bruta.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "minutes",
          "transcript"
        ],
        "type": "object"
      },
      "V1MeetingSummary": {
        "description": "Reunião vista pelo sync de calendário v1.",
        "properties": {
          "auto_record": {
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "duration_min": {
            "format": "int32",
            "type": "integer"
          },
          "format": {
            "description": "Opções de sessão (R184): `meeting|training|broadcast|hybrid`.",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "description": "`video` | `voice`.",
            "type": "string"
          },
          "minutes_ai_at": {
            "description": "Presente ⇒ a ata AI já foi gerada.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "record_quality": {
            "description": "`2160p|1080p|720p|audio`.",
            "type": "string"
          },
          "room_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "waiting_room": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "kind",
          "starts_at",
          "duration_min",
          "created_at",
          "format",
          "waiting_room",
          "auto_record",
          "record_quality"
        ],
        "type": "object"
      },
      "V1Org": {
        "description": "Organização vista pela API v1.",
        "properties": {
          "domain": {
            "description": "Domínio de produção dos links (vazio se não definido).",
            "type": "string"
          },
          "email_domain": {
            "description": "Domínio de email da organização (vazio se não definido).",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "members": {
            "description": "Número de linhas de membro da organização.",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email_domain",
          "domain",
          "members"
        ],
        "type": "object"
      },
      "V1Recording": {
        "description": "Gravação vista pela API v1.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "download_url": {
            "description": "`/api/recordings/{id}/content` (rota da BFF, autenticada por sessão).",
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "room_code": {
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "filename",
          "size_bytes",
          "created_at",
          "room_code",
          "download_url"
        ],
        "type": "object"
      },
      "V1RecordingList": {
        "properties": {
          "recordings": {
            "items": {
              "$ref": "#/components/schemas/V1Recording"
            },
            "type": "array"
          }
        },
        "required": [
          "recordings"
        ],
        "type": "object"
      },
      "V1RoomInfo": {
        "description": "Sala vista pela API v1.",
        "properties": {
          "code": {
            "type": "string"
          },
          "e2ee": {
            "type": "boolean"
          },
          "join_url": {
            "description": "Link de entrada: absoluto com o domínio de produção da org, ou relativo\n(`/#/r/{code}`) se não houver domínio.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "waiting_room": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "name",
          "e2ee",
          "waiting_room",
          "join_url"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api_key": {
        "description": "Chave de API da organização (`dlx_…`).",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "bearerFormat": "JWT",
        "description": "Access token da sessão (15 min), renovado por /api/auth/refresh.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Superfície estável do inquilino para SDK, mobile e integrações. Chave `dlx_` com escopos. Muda só com v2.",
    "license": {
      "name": ""
    },
    "title": "Delonix Meet — API pública v1",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/meetings": {
      "get": {
        "operationId": "v1_meetings",
        "parameters": [
          {
            "description": "Cursor incremental: devolve reuniões criadas, com ata AI atualizada ou\ncom início desde este instante. Omisso => tudo (limitado a 500).",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V1MeetingList"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`since` não é RFC 3339."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Chave ausente, sem prefixo `dlx_`, desconhecida ou revogada (`auth.unauthenticated`), ou expirada (`api_key.expired`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A chave não tem o escopo `meetings:read` (`api_key.scope_missing`, escopo em `details`)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Limite de pedidos da v1 por chave (`Retry-After` com o que falta da janela)."
          }
        },
        "security": [
          {
            "api_key": [
              "meetings:read"
            ]
          }
        ],
        "summary": "`GET /api/v1/meetings?since=<rfc3339>` — reuniões da organização (dono é\nmembro), incremental para o cron de sync do Odoo (idempotente no cliente).\nNo máximo 500, por `starts_at`.",
        "tags": [
          "v1"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMeetingReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingResp"
                }
              }
            },
            "description": "Criada, ou reencontrada pela `external_ref` (`existing: true`)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`title` vazio, `kind`, `duration_min`, `host_email` inválidos ou mais de 200 convidados; `meeting.invalid_format` / `meeting.invalid_record_quality`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "chave de API ausente, inválida ou revogada (`auth.unauthenticated`), ou expirada (`api_key.expired`)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "a chave não tem o escopo `meetings:write` (`api_key.scope_missing`, escopo em `details`)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "a `external_ref` aponta para uma reunião que já não se resolve na organização"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "o anfitrião pertence a outra organização"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`meeting.host_outside_org_domain`; ou `meeting.auto_record_e2ee` (gravação automática pedida numa sala E2EE)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate-limit da v1, por chave (`Retry-After` com o que falta da janela)"
          }
        },
        "security": [
          {
            "api_key": [
              "meetings:write"
            ]
          }
        ],
        "summary": "`POST /api/v1/meetings` — cria (ou reencontra) uma reunião agendada com\nsala, anfitrião e convidados.",
        "tags": [
          "meetings"
        ]
      }
    },
    "/api/v1/meetings/{meeting_id}": {
      "delete": {
        "description": "A sala só é apagada se não tiver gravações: a reunião pode ter acontecido\ne sido cancelada no calendário depois, e uma gravação é um artefacto que o\nutilizador espera manter (a FK `recordings.room_id` é ON DELETE CASCADE —\napagar a sala apagaria o registo da gravação).",
        "operationId": "delete",
        "parameters": [
          {
            "description": "Id da reunião",
            "in": "path",
            "name": "meeting_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteMeetingResp"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "chave de API ausente, inválida ou revogada (`auth.unauthenticated`), ou expirada (`api_key.expired`)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "a chave não tem o escopo `meetings:write` (`api_key.scope_missing`, escopo em `details`)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "a reunião não existe ou não pertence à organização da chave (`meetings.org_id`)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate-limit da v1, por chave (`Retry-After` com o que falta da janela)"
          }
        },
        "security": [
          {
