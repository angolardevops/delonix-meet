{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "Envelope de erro de todas as superfícies (ver `error.rs`).",
        "properties": {
          "code": {
            "description": "Código estável (contrato), p.ex. `registration.domain_taken`.",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "type": "array"
          },
          "error": {
            "description": "Mensagem para pessoas. Pode mudar.",
            "type": "string"
          },
          "request_id": {
            "description": "Igual ao cabeçalho `X-Request-Id`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "code",
          "details"
        ],
        "type": "object"
      },
      "FieldViolation": {
        "properties": {
          "description": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "description"
        ],
        "type": "object"
      },
      "UpdateMeReq": {
        "properties": {
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "created_at"
        ],
        "type": "object"
      },
      "Webhook": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "events": {
            "description": "Eventos subscritos, separados por vírgula (ver `KNOWN_EVENTS`).",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "description": "`slack` | `teams` | `mattermost` | `generic`.",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "org_id",
          "kind",
          "url",
          "events",
          "active"
        ],
        "type": "object"
      },
      "WebhookReq": {
        "properties": {
          "events": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api_key": {
        "description": "Chave de API da organização (`dlx_…`).",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "bearerFormat": "JWT",
        "description": "Access token da sessão (15 min), renovado por /api/auth/refresh.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API interna do web Delonix. **Instável**: muda com o frontend. Erros no envelope `ErrorBody`.",
    "license": {
      "name": ""
    },
    "title": "Delonix Meet — BFF",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/orgs/{org_id}/webhooks": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Webhook"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Webhooks da organização. Só administradores.",
        "tags": [
          "webhooks"
        ]
      },
      "post": {
        "operationId": "create",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Cria um webhook. O URL passa pela guarda anti-SSRF.",
        "tags": [
          "webhooks"
        ]
      }
    },
    "/api/orgs/{org_id}/webhooks/{hook_id}": {
      "delete": {
        "operationId": "delete",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "hook_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{\"ok\": true}` (forma herdada)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Apaga um webhook.",
        "tags": [
          "webhooks"
        ]
      }
    },
    "/api/users/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "O perfil de quem está autenticado.",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Atualiza os próprios dados: username e/ou password (cada campo é opcional).",
        "tags": [
          "users"
        ]
      }
    },
    "/api/users/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "description": "Termo (email ou username), 2+ caracteres.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserPublic"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Pesquisa utilizadores por email/username (para convidar/partilhar).\nDevolve no máximo 10; exclui o próprio.",
        "tags": [
          "users"
        ]
      }
    }
  }
}
