# Não enviar artefactos de build/deps para o contexto Docker — são recriados
# dentro da imagem e só poluíam o contexto (centenas de MB) e a cache.
server/target/
web/node_modules/
# NÃO ignorar web/dist/ — o Dockerfile.web.stage copia o dist pré-compilado.
# (O Dockerfile.web de origem recompila, por isso tê-lo no contexto é inócuo.)
mobile/build/
mobile/.dart_tool/

# Assets de IA pesados (obtidos na build via fetch com SHA — ver Dockerfile.web)
web/public/ort/
web/public/ort-rvm/
web/public/models/rvm/
web/public/models/Xenova/

# Dados de utilizador / segredos / git
server/recordings/
deploy/delonix.env
.git/
agents/worktrees/
**/*.tsbuildinfo
.DS_Store
