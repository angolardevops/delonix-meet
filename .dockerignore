web/public/ort/
web/public/ort-rvm/
web/public/models/rvm/
web/public/models/Xenova/

# Dados de utilizador / segredos / git
server/recordings/
deploy/delonix.env
.git/
agents/worktrees/
**/*.tsbuildinfo
.DS_Store
