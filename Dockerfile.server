# syntax=docker/dockerfile:1
# ============================================================
#  Delonix Meet — imagem do backend (Rust axum + SFU)
#  Runtime ROOTLESS: distroless :nonroot (uid 65532, sem shell, sem root).
#  Build compatível com Docker BuildKit E com Podman/Buildah (rootless).
# ============================================================

FROM rust:1-bookworm AS build
WORKDIR /src
# Limita a paralelização do rustc: em hosts com RAM pressionada, o link em
# release de todos os codegen units em paralelo pode ser morto por OOM
# (cargo devolve exit 101). 6 jobs é seguro sem penalizar muito o tempo.
ENV CARGO_BUILD_JOBS=6
# As migrações são embutidas em compile-time (sqlx::migrate!) — a imagem final
# não precisa de ficheiros .sql. Copia-se o crate inteiro e compila-se em release.
COPY server ./server
# SEM `--mount=type=cache`: o motor de build da plataforma é o `delonix build`
# (daemonless/rootless) e ainda só suporta `--mount=type=secret` — com os cache
# mounts o build falhava com «só type=secret é suportado». O trade-off é
# recompilar as dependências a cada alteração no server/ (~10 min); se isso
# passar a doer, o caminho é cargo-chef (camada de deps em cache de LAYER, que
# funciona sem BuildKit), não voltar aos cache mounts.
RUN cd server && cargo build --release && \
    cp target/release/delonix-server /usr/local/bin/delonix-server && \
    strip /usr/local/bin/delonix-server

# Runtime mínimo, sem root. `cc` traz a glibc/libssl necessárias ao binário.
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /usr/local/bin/delonix-server /app/delonix-server
USER nonroot:nonroot
EXPOSE 8180
ENV BIND_ADDR=0.0.0.0:8180
# Health: GET /health -> "ok"
ENTRYPOINT ["/app/delonix-server"]
