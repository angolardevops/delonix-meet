# syntax=docker/dockerfile:1
# ============================================================
#  Delonix Meet — imagem do backend (Rust axum + SFU)
#  Runtime ROOTLESS: distroless :nonroot (uid 65532, sem shell, sem root).
#  Build compatível com Docker BuildKit E com Podman/Buildah (rootless).
# ============================================================

FROM rust:1-bookworm AS build
WORKDIR /src
# Limita a paralelização do rustc: em hosts com RAM pressionada, o link em
# release de todos os codegen units em paralelo pode ser morto por OOM
# (cargo devolve exit 101). 6 jobs é seguro sem penalizar muito o tempo.
ENV CARGO_BUILD_JOBS=6
# Sem libopus no build nem no runtime: a ponte telefone↔sala usa o `opus-rs`,
# em Rust puro (ADR-0010). O `audiopus`, que se ligava à lib do sistema por
# pkg-config, saiu — e com ele a instalação aqui e a cópia do .so para a
# imagem final.
# As migrações são embutidas em compile-time (sqlx::migrate!) — a imagem final
# não precisa de ficheiros .sql. Copia-se o crate inteiro e compila-se em release.
COPY server ./server
# SEM `--mount=type=cache`: o motor de build da plataforma é o `delonix build`
# (daemonless/rootless) e ainda só suporta `--mount=type=secret` — com os cache
# mounts o build falhava com «só type=secret é suportado». O trade-off é
# recompilar as dependências a cada alteração no server/ (~10 min); se isso
# passar a doer, o caminho é cargo-chef (camada de deps em cache de LAYER, que
# funciona sem BuildKit), não voltar aos cache mounts.
RUN cd server && cargo build --release && \
    cp target/release/delonix-server /usr/local/bin/delonix-server && \
    strip /usr/local/bin/delonix-server

# ------------------------------------------------------------
# ffmpeg LGPL para o servidor (ADR-0011, D3 e B3).
#
# O servidor só precisa de `-c copy`, `aac` nativo, libvpx-vp9 e libopus: nada
# que exija libx264. Por isso o ffmpeg desta imagem é uma build LGPL (a GPL com
# libx264 é da imagem do Channel Engine). NÃO se usa o `apt install ffmpeg` do
# Debian: é compilado com `--enable-gpl` e arrastaria a imagem para a GPL.
#
# - `--disable-gpl --disable-nonfree`: a licença é a LGPL v2.1+; um libx264,
#   libx265 ou libfdk-aac fora de questão (o gate `check-ffmpeg-licenca.sh` falha).
# - `--enable-shared --disable-static`: a LGPL pede ligação dinâmica para quem
#   redistribui, e o utilizador tem de poder substituir a biblioteca.
# - `--disable-autodetect`: só entra o que se pede, nada que o sistema por acaso
#   tenha instalado.
# - O código-fonte é o do ffmpeg.org, com versão e SHA-256 fixados. Quem recebe
#   a imagem recebe também o endereço desse código e a linha de configuração
#   (`/opt/ffmpeg/SOURCE.txt`) e o texto da licença (`COPYING.LGPLv2.1`).
# ------------------------------------------------------------
FROM debian:bookworm-slim AS ffmpeg
ARG FFMPEG_VERSION=9.0.2
# SHA-256 de ffmpeg-${FFMPEG_VERSION}.tar.xz, calculado depois de verificar a
# assinatura PGP do release (chave FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8,
# a mesma que ffmpeg.org/download.html publica). Ao subir a versão, refazer as duas coisas.
ARG FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils build-essential nasm pkg-config \
        libvpx-dev libopus-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSL -o ffmpeg.tar.xz "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" \
    && echo "${FFMPEG_SHA256}  ffmpeg.tar.xz" | sha256sum -c - \
    && tar xJf ffmpeg.tar.xz
# `--disable-new-dtags` + rpath: um RUNPATH não é herdado pelas bibliotecas, e o
# libavcodec não encontraria o libvpx. Assim o binário corre sem LD_LIBRARY_PATH.
RUN cd "ffmpeg-${FFMPEG_VERSION}" && ./configure \
        --prefix=/opt/ffmpeg \
        --disable-gpl --disable-nonfree \
        --disable-autodetect --disable-doc --disable-ffplay \
        --enable-shared --disable-static \
        --enable-libvpx --enable-libopus --enable-zlib \
        --extra-ldexeflags="-Wl,--disable-new-dtags,-rpath,/opt/ffmpeg/lib" \
        --extra-ldsoflags="-Wl,--disable-new-dtags,-rpath,/opt/ffmpeg/lib" \
    && make -j"$(nproc)" && make install \
    && cp COPYING.LGPLv2.1 /opt/ffmpeg/COPYING.LGPLv2.1
# Sem cabeçalhos nem .pc de desenvolvimento: a imagem só corre o ffmpeg. As
# bibliotecas de que ele depende e que a imagem final não traz (libvpx, libopus,
# libz) copiam-se para junto das dele; as da glibc ficam de fora: a imagem final
# já as tem.
RUN rm -rf /opt/ffmpeg/include /opt/ffmpeg/lib/pkgconfig \
    && for b in /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe; do ldd "$b"; done \
        | awk '/=> \//{print $3}' | sort -u \
        | grep -vE '/(libc|libm|libdl|libpthread|librt|libgcc_s|ld-linux[^/]*)\.so' \
        | grep -v '^/opt/ffmpeg/' \
        | xargs -r -I{} cp -L {} /opt/ffmpeg/lib/ \
    && mkdir -p /opt/ffmpeg/licenses \
    && for p in libvpx7 libopus0 zlib1g; do \
         cp "/usr/share/doc/$p/copyright" "/opt/ffmpeg/licenses/$p.copyright"; done \
    && { echo "ffmpeg ${FFMPEG_VERSION} — LGPL v2.1+"; \
         echo "bibliotecas de terceiros copiadas junto (avisos em licenses/): libvpx, libopus, zlib"; \
         echo "código-fonte: https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz (sha256 ${FFMPEG_SHA256})"; \
         /opt/ffmpeg/bin/ffmpeg -version | sed -n 's/^configuration: /configuração: /p'; \
       } > /opt/ffmpeg/SOURCE.txt \
    && /opt/ffmpeg/bin/ffmpeg -L | head -3 | grep -q Lesser \
    && ! /opt/ffmpeg/bin/ffmpeg -version | grep -E 'enable-(gpl|nonfree|version3)'

# Runtime mínimo, sem root. `cc` traz a glibc/libssl necessárias ao binário.
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /usr/local/bin/delonix-server /app/delonix-server
# ffmpeg LGPL + ffprobe + as suas bibliotecas + licença e código-fonte (ver o estágio `ffmpeg`).
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
ENV FFMPEG_BIN=/opt/ffmpeg/bin/ffmpeg FFPROBE_BIN=/opt/ffmpeg/bin/ffprobe
USER nonroot:nonroot
# 8180 — HTTP público (/api, /ws, /rtc, /health, /ready). BIND_ADDR.
EXPOSE 8180
# 8181 — listener INTERNO (/api/voice/ivr/*, /metrics). Só com INTERNAL_BIND_ADDR;
#        nunca atrás de um ingress (ADR-0006 §3).
# 9180 — gRPC entre máquinas, mTLS. Só com GRPC_BIND_ADDR (+ GRPC_TLS_CERT,
#        GRPC_TLS_KEY, GRPC_CLIENT_CA). Desligadas por omissão: o EXPOSE é
#        documentação, não abre nada.
EXPOSE 8181 9180
ENV BIND_ADDR=0.0.0.0:8180
# Subcomando `migrate`: corre as migrações embutidas e sai (Job da edição SaaS,
# deploy/k8s-overlays/saas/migrate-job.yaml). A UI não vem na imagem: a edição
# pessoal monta a SPA construída e aponta UI_DIR para ela
# (deploy/delonix/meet-stack-personal.yaml).
# Health: GET /health -> "ok"
ENTRYPOINT ["/app/delonix-server"]
